{
  "name": "ecoprompt-cli",
  "version": "1.2.0",
  "description": "Zero-config reverse proxy that optimizes AI coding sessions by intelligently routing prompts to the most cost-effective model",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ecoprompt": "bin/cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^5.4.0",
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/raquib007r/ecoprompt.git"
  },
  "bugs": {
    "url": "https://github.com/raquib007r/ecoprompt/issues"
  },
  "keywords": [
    "ai",
    "proxy",
    "cost-optimization",
    "claude",
    "openai",
    "gemini",
    "cli",
    "reverse-proxy",
    "llm",
    "vibe-coding"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ]
}
